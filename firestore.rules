rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ferryStatus/current {
      allow read: if true;
      allow write: if false;
    }
    match /ferryStatus/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /notificationSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Rides collection
    match /rides/{rideId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
            allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    // Capacity history collection (server and authenticated users). Users may
    // delete their own reports (automated records have no userUid, so they
    // can never match the delete rule); no updates — a re-tag is a new doc.
    match /capacityHistory/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['sailingKey', 'capacity', 'userUid'])
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userUid;
    }

    // Lineup reports: riders marking when the car lineup reached the
    // crosswalk, or refuting that it has (crosswalkAt null + notYet true).
    // Same shape as capacityHistory: create + own-delete only.
    match /lineupReports/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['sailingKey', 'crosswalkAt', 'userUid'])
        && (request.resource.data.crosswalkAt is number
            || (request.resource.data.notYet == true && request.resource.data.crosswalkAt == null))
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userUid;
    }

    // Per-frame terminal labels: "were cars waiting in THIS photo?". The
    // terminal classifier is a frame model, so this is the only rider input
    // that can actually supervise it — capacity tags describe a whole
    // sailing and can't say which frame was misread. Straight into the
    // training set, so the shape is checked tightly (hasOnly, not just
    // hasAll) and the frame must be a Bowen terminal path. Rules can't
    // rate-limit; the defences against a bad actor are one vote per user per
    // frame in effectiveFrameLabel() and hand labels winning over rider ones.
    match /frameLabels/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['framePath', 'sailingKey', 'carsWaiting', 'userUid', 'recordedAt'])
        && request.resource.data.keys().hasOnly(['framePath', 'sailingKey', 'carsWaiting', 'userUid',
            'recordedAt', 'userName', 'userPhoto', 'anonymous', 'userReport', 'autoP', 'autoModel'])
        && request.resource.data.framePath is string
        && request.resource.data.framePath.matches('^webcams/bowen/.*[.]jpg$')
        && request.resource.data.sailingKey is string
        && request.resource.data.carsWaiting is bool
        && request.resource.data.recordedAt is number
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userUid;
    }

    // Sailing status collection (server-write only)
    match /sailingStatus/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Snapshots collection (server-write only)
    match /snapshots/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Precomputed leaderboard aggregate (server-write only)
    match /aggregates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Classifier model registry (server-write only; models are public anyway
    // — they ship in the webapp bundle)
    match /classifierModels/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}